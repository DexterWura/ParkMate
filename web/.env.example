APP_NAME=OpenLot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://openlot.companyop.com

# Production tips:
# APP_ENV=production
# APP_DEBUG=false
# FORCE_HTTPS=true
# QUEUE_CONNECTION=sync   # default; OSM ingest runs afterResponse without a worker

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=openlot
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/social/google/callback"

# Stripe / Cashier
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=usd

STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

BILLING_CHECKOUT_SUCCESS_URL="${APP_URL}/billing/success"
BILLING_CHECKOUT_CANCEL_URL="${APP_URL}/billing/cancel"
BILLING_PORTAL_RETURN_URL="${APP_URL}/settings/billing"

# Payment gateways
PAYMENTS_DEFAULT_GATEWAY=stripe
PAYMENTS_STRIPE_SUCCESS_URL="${APP_URL}/payments/success"
PAYMENTS_STRIPE_CANCEL_URL="${APP_URL}/payments/cancel"

# Paynow (Zimbabwe)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL="${APP_URL}/api/v1/payments/paynow/callback"
PAYNOW_RETURN_URL="${APP_URL}/payments/success"

# Pesepay (Zimbabwe)
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_RESULT_URL="${APP_URL}/api/v1/payments/pesepay/callback"
PESEPAY_RETURN_URL="${APP_URL}/payments/success"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# Boilerplate
API_RATE_LIMIT=60
API_AUTH_RATE_LIMIT=10
AUTH_REQUIRE_EMAIL_VERIFICATION=true
AUTH_PASSWORD_MIN=8
SANCTUM_TOKEN_EXPIRATION=
FORCE_HTTPS=false
SECURITY_HEADERS=true
CORS_ALLOWED_ORIGINS=*

FEATURE_GOOGLE_AUTH=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_PAYMENTS=true
